# Local development only. Never commit local.properties or .env.
# Use the Supabase Project URL + Publishable key. Never use a service_role/secret key.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Optional: Gemini integration if the app uses it.
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
